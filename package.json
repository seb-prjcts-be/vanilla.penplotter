{
  "name": "vanilla.penplotter",
  "version": "0.5.0",
  "description": "A modular JavaScript planning engine for generative art and pen plotters.",
  "type": "module",
  "main": "vanilla.penplotter.js",
  "exports": {
    ".": "./vanilla.penplotter.js",
    "./core": "./src/core/model.js",
    "./geometry": "./src/geometry/index.js",
    "./optimizer": "./src/optimizer/index.js",
    "./planner": "./src/planner/index.js",
    "./renderer": "./src/renderer/index.js",
    "./driver": "./src/driver/index.js",
    "./driver/ebb": "./src/driver/ebb.js",
    "./plugins": "./src/plugins/index.js",
    "./driver/grbl": "./src/driver/grbl.js",
    "./driver/auto": "./src/driver/auto.js"
  },
  "files": [
    "vanilla.penplotter.js",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node tests/snapshot.js && node tests/ebb.js && node tests/ebb-queue.js && node tests/grbl.js && node tests/regressions.js && node tests/version.js",
    "docs": "node tools/build-docs.js",
    "manifest": "node tools/gen-manifest.js",
    "test:waves": "node tests/waves-integration.js tests/fixtures/vanilla-waves-core.js"
  },
  "repository": "github:seb-prjcts-be/vanilla.penplotter",
  "homepage": "https://seb-prjcts-be.github.io/vanilla.penplotter/",
  "license": "MIT",
  "private": true
}
